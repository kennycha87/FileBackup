<Window x:Class="KlstBackup.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:KlstBackup.ViewModels"
        xmlns:res="clr-namespace:KlstBackup.Resources"
        Title="{x:Static res:Strings.App_Title}"
        Width="980" Height="640"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <vm:InverseBooleanConverter x:Key="InverseBool" />
        <vm:EnumEqualsToVisibilityConverter x:Key="EnumToVis" />
    </Window.Resources>

    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Height="30">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" MaxWidth="560" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="240" Height="14"
                             Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent, Mode=OneWay}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" MaxWidth="420"
                           Foreground="Gray" />
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="6">
            <!-- ================= Jobs ================= -->
            <TabItem Header="{x:Static res:Strings.Tab_Jobs}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,10,0">
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button Content="{x:Static res:Strings.Btn_New}" Command="{Binding NewJobCommand}" Padding="12,4" Margin="0,0,6,0" />
                            <Button Content="{x:Static res:Strings.Btn_Edit}" Command="{Binding EditJobCommand}" Padding="12,4" Margin="0,0,6,0" />
                            <Button Content="{x:Static res:Strings.Btn_Delete}" Command="{Binding DeleteJobCommand}" Padding="12,4" Margin="0,0,6,0" />
                            <Button Content="{x:Static res:Strings.Btn_RunNow}" Command="{Binding RunNowCommand}" Padding="12,4" Margin="0,0,6,0"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                            <Button Content="{x:Static res:Strings.Btn_Stop}" Command="{Binding StopRunCommand}" Padding="12,4" Margin="0,0,6,0"
                                    IsEnabled="{Binding IsBusy}" />
                            <Button Content="{x:Static res:Strings.Btn_Dashboard}" Command="{Binding OpenDashboardCommand}" Padding="12,4" />
                        </WrapPanel>

                        <ListBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4">
                                        <DockPanel>
                                            <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,0,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding ScheduleSummary}" Foreground="Gray" FontSize="11"
                                                   Margin="24,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
                            Padding="16" Background="#FAFAFA">
                        <StackPanel DataContext="{Binding SelectedJob}">
                            <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ScheduleSummary}" Foreground="Gray" Margin="0,4,0,14" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static res:Strings.Detail_Source}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SourcePath}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static res:Strings.Detail_Destination}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DestPath}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DestPath}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static res:Strings.Detail_BackupType}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding JobType}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static res:Strings.Detail_NextRun}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NextRunText}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static res:Strings.Detail_LastRun}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LastRunText}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static res:Strings.Detail_Enabled}" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="5" Grid.Column="1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{x:Static res:Strings.Common_No}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                    <Setter Property="Text" Value="{x:Static res:Strings.Common_Yes}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Text="{x:Static res:Strings.Hint_Differential}"
                                       TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,16,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ================= History ================= -->
            <TabItem Header="{x:Static res:Strings.Tab_History}">
                <DataGrid Margin="8" ItemsSource="{Binding History}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          CanUserAddRows="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:Strings.Col_Job}" Binding="{Binding JobName}" Width="150" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Col_StartedLocal}" Binding="{Binding StartedUtc, Converter={StaticResource UtcToLocalText}}" Width="Auto" MinWidth="170" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Col_Type}" Binding="{Binding Type, Converter={StaticResource EnumDisplayName}}" Width="90" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Col_Status}" Binding="{Binding Status, Converter={StaticResource EnumDisplayName}}" Width="150" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Col_Files}" Binding="{Binding FilesCopied}" Width="70" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Col_Bytes}" Binding="{Binding BytesCopied, StringFormat=N0}" Width="110" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Col_Duration}" Binding="{Binding Duration, StringFormat=hh\:mm\:ss}" Width="90" />
                        <DataGridTextColumn Header="{x:Static res:Strings.Col_Details}" Binding="{Binding Message, Converter={StaticResource RunMessage}}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- ================= Restore ================= -->
            <TabItem Header="{x:Static res:Strings.Tab_Restore}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="{x:Static res:Strings.Restore_Heading}" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,0,0,12" />

                        <TextBlock Text="{x:Static res:Strings.Restore_Job}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Jobs}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding RestoreJob}" Margin="0,0,0,10" />

                        <TextBlock Text="{x:Static res:Strings.Restore_BackupSet}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding BackupSets}"
                                  SelectedItem="{Binding SelectedBackupSet}" Margin="0,0,0,10" />

                        <TextBlock Text="{x:Static res:Strings.Restore_TargetFolder}" Margin="0,0,0,4" />
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Btn_Browse}" Padding="10,3"
                                    Command="{Binding BrowseRestoreTargetCommand}" Margin="6,0,0,0" />
                            <TextBox Text="{Binding RestoreTargetPath, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" />
                        </DockPanel>

                        <Button Content="{x:Static res:Strings.Btn_Restore}" Padding="20,5" HorizontalAlignment="Left"
                                Command="{Binding RestoreCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="Gray"
                                   Text="{x:Static res:Strings.Hint_Restore}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Settings ================= -->
            <TabItem Header="{x:Static res:Strings.Tab_Settings}">
                <StackPanel Margin="20" MaxWidth="680" HorizontalAlignment="Left">
                    <CheckBox Content="{x:Static res:Strings.Settings_StartWithWindows}"
                              IsChecked="{Binding StartWithWindows, UpdateSourceTrigger=PropertyChanged}"
                              Margin="0,0,0,10" />
                    <TextBlock Text="{x:Static res:Strings.Settings_Language}" Margin="0,16,0,4" />
                    <ComboBox Width="280" HorizontalAlignment="Left"
                              ItemsSource="{Binding LanguageOptions}"
                              DisplayMemberPath="NativeName" SelectedValuePath="Tag"
                              SelectedValue="{Binding Language, Mode=TwoWay}" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,6,0,0"
                               Text="{x:Static res:Strings.Status_LanguageRestartHint}" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,16,0,0"
                               Text="{x:Static res:Strings.Hint_Tray}" />
                    <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,16,0,0"
                               Text="{x:Static res:Strings.Hint_AppData}" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
